    "no_private_repo_write_token": true
  },
  "output_contract": {
    "allowed": [
      "PUBLIC_SOURCE_URLS",
      "PUBLIC_SOURCE_SHA256",
      "REPORT_PERIOD",
      "PUBLIC_FINANCIAL_FACTS",
      "PUBLIC_ANNOUNCEMENTS",
      "PUBLIC_QUOTES",
      "PARSER_DIAGNOSTICS",
      "SOURCE_PROVENANCE",
      "PUBLIC_DETERMINISTIC_METRICS",
      "PUBLIC_EVIDENCE_INDEX",
      "PUBLIC_RUN_SNAPSHOT",
      "DETERMINISTIC_PUBLIC_RATIOS"
    ],
    "prohibited": [
      "ACCOUNT_STATE",
      "ACTUAL_HELD",
      "PORTFOLIO_ACTION",
      "USER_DECISION",
      "PRIVATE_VALUATION_DECISION"
    ],
    "compute_limitations": [
      "NO_VALUATION",
      "NO_RECOMMENDATION",
      "NO_PORTFOLIO_LOGIC",
      "NO_TRADE_LOGIC",
      "SOURCE_VERIFICATION_STATE_NOT_UPGRADED"
