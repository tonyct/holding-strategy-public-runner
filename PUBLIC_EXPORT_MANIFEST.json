      "engine/collect_quotes.py",
      "engine/fetch_official_filings.py",
      "engine/fetch_hk_official.py",
      "engine/reconcile_original.py",
      "engine/reconcile_hk_core.py",
      "engine/extract_report_notes.py",
      "engine/audit_acquisition.py",
      "engine/audit_provenance.py",
      "engine/public_metrics.py",
      "engine/public_evidence_index.py",
      "engine/public_run_snapshot.py"
    ],
    "generated_public_files": [
      "README.md",
      "config/research_universe.json",
      ".github/workflows/public_research.yml",
      "engine/universe.py",
      ".github/workflows/public_compute_regression.yml",
      "tests/test_public_metrics.py",
      "tests/test_public_evidence_index.py",
      "tests/test_public_run_snapshot.py",
      "tests/test_public_compute_contract.py"
    ]
  },
  "denylist_prefixes": [
    "runtime/",
    "receipts/",
    "research/main/",
    "research/policies/",
    "research/audits/",
    "evidence/"
