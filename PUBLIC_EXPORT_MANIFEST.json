  },
  "source_history_policy": "DO_NOT_FORK_PRIVATE_REPO; CREATE_FRESH_PUBLIC_REPOSITORY_WITH_NEW_HISTORY",
  "notes": [
    "runtime/latest is generated by this public repository from public sources and must never be imported from private runtime.",
