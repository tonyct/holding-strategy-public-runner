{
  "schema": "E36_PUBLIC_RUNNER_EXPORT_MANIFEST/v1",
  "purpose": "Self-contained public GitHub Actions runner for public-market acquisition, parsing, integrity indexing, and deterministic public computations",
  "source_repository": "tonyct/holding-strategy-public-runner",
  "target_repository_suggested": "tonyct/holding-strategy-public-runner",
  "privacy_contract": {
