    "market",
    "report_period",
    "lookback_days",
    "data_types"
  ],
  "forbidden_semantics": [
    "holding",
    "owned",
    "portfolio",
    "position",
    "quantity",
    "cost_basis",
    "cash",
    "nav",
    "order",
    "fill",
    "weight",
