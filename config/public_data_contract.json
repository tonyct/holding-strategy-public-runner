    "add",
    "reduce",
    "exit",
    "portfolio_decision"
  ],
  "allowed_data_types": [
    "quotes",
    "announcements",
    "financials",
    "official_filings",
    "community_discovery",
    "news_discovery",
    "ir_discovery",
    "deterministic_metrics",
    "evidence_index",
    "run_snapshot",
    "official_original_bytes",
    "lead_lifecycle",
    "original_text_candidates",
    "company_research_packet",
    "evidence_registry"
  ],
  "output_requirements": [
    "source",
    "source_timestamp_or_session_date",
    "period_or_as_of",
    "sha256_or_content_identity",
    "verification_state"
