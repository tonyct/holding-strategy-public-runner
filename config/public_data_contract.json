{
  "schema": "PUBLIC_DATA_ACQUISITION_CONTRACT/v1",
  "contract_id": "PUBLIC_DATA_ACQUISITION_CONTRACT_V1_20261007",
  "role": "PUBLIC_MARKET_DATA_EVIDENCE_AND_DETERMINISTIC_COMPUTE_ONLY",
  "request_semantics": "RESEARCH_COVERAGE_NOT_ACCOUNT_HOLDINGS",
  "allowed_request_fields": [
